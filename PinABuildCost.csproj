<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Version>0.2.2</Version>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GameDir Condition="'$(GameDir)' == ''">D:\SteamLibrary\steamapps\common\Super Fantasy Kingdom</GameDir>
    <ProfileDir Condition="'$(ProfileDir)' == ''">$(APPDATA)\Thunderstore Mod Manager\DataFolder\SuperFantasyKingdom\profiles\Daybook Dev</ProfileDir>
    <ManagedDir>$(GameDir)\Super Fantasy Kingdom_Data\Managed</ManagedDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/**/*.cs" />
    <Reference Include="Newtonsoft.Json;UnityEngine.JSONSerializeModule;Unity.Localization;Unity.ResourceManager">
      <HintPath>$(ManagedDir)\%(Identity).dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx;0Harmony">
      <HintPath>$(ProfileDir)\BepInEx\core\%(Identity).dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp;Unity.InputSystem;UnityEngine;UnityEngine.CoreModule;UnityEngine.UI;UnityEngine.UIModule;UnityEngine.TextRenderingModule;Unity.TextMeshPro">
      <HintPath>$(ManagedDir)\%(Identity).dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
